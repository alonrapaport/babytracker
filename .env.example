# Copy this file to ".env" and fill in your Supabase project values.
# Find them in your Supabase dashboard: Project Settings -> API.
# Without them the app runs in demo mode only (add "demo" to the URL or build with VITE_DEMO=1).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY
