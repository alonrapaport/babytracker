{
  "manifest_version": 3,
  "name": "RecipeBox Clipper",
  "version": "1.0.0",
  "description": "Save the recipe on the current page straight into your RecipeBox.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Save recipe to RecipeBox"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon-128.png"
  }
}
